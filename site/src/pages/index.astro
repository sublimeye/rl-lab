---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, url } from '../lib';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.number - a.data.number,
);
---

<Base title="rl-lab">
  <h1>Teaching small things to move</h1>
  <p class="intro">
    Experiments in reinforcement learning, trained on a laptop. Each one has replays of the agent
    at different stages of training, so you can watch it go from flailing to competent.
  </p>
  <ol class="log">
    {
      posts.map((p) => (
        <li>
          <span class="num">{String(p.data.number).padStart(3, '0')}</span>
          <div>
            <a href={url(`posts/${p.id}/`)}>{p.data.title}</a>
            <p class="muted">{p.data.summary}</p>
            <time datetime={p.data.date.toISOString().slice(0, 10)} class="muted">{formatDate(p.data.date)}</time>
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .intro {
    font-size: 1.15rem;
    max-width: 36rem;
    margin-bottom: 2.5rem;
  }
  .log {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .log li {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.75rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .num {
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .log a {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .log p {
    margin: 0.3rem 0 0.35rem;
  }
  time {
    font-size: 0.88rem;
  }
</style>
